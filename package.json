{
  "name": "idara-pro",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:migrate": "pnpm --filter @idara-pro/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @idara-pro/api db:seed",
    "db:seed:demo": "pnpm --filter @idara-pro/api db:seed:demo",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "checkup": "pnpm --filter @idara-pro/api checkup",
    "build:web": "turbo run build --filter=@idara-pro/web",
    "preview:web": "pnpm build:web && pnpm --filter @idara-pro/web exec vite preview --port 5173 --strictPort",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  }
}
