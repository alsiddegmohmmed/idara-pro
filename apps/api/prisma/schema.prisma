// Stage 3 scope only (docs/roadmap.md Phase 0): companies, branches, users, roles,
// permissions, refresh_tokens, audit_log + the join tables roles/permissions need to
// be usable (role_permissions, user_roles). Employees, attendance, leave, custody,
// payroll tables land with their own modules in later phases.
//
// Tenancy (docs/adr/0004-rls-deferred.md): every business table carries company_id,
// NOT NULL, indexed. Two exceptions are intentionally global, not tenant-scoped:
// `permissions` (fixed resource:action catalog, mirrors packages/shared PERMISSIONS)
// and system rows of `roles` (is_system = true; a company's own custom roles do carry
// company_id). All reads/writes go through `withTenant()` (apps/api/src/shared/database),
// never a raw injected PrismaClient — see the ADR for why.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev/CI (glibc). linux-musl-openssl-3.0.x for the prod
  // image (node:24-alpine, Alpine 3.24, OpenSSL 3.x) — without it, the query
  // engine fails at runtime with "Error loading shared library libssl.so.1.1"
  // since modern Alpine dropped the OpenSSL 1.1 compat libs Prisma defaults to.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  disabled

  @@map("user_status")
}

model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  crNumber  String?  @map("cr_number")
  vatNumber String?  @map("vat_number")
  timezone  String   @default("Asia/Riyadh")
  weekendDays Int[]  @map("weekend_days") @default([5, 6])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  workSchedules       WorkSchedule[]
  holidays            Holiday[]
  users               User[]
  roles               Role[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogEntries     AuditLogEntry[]

  @@map("companies")
}

model Branch {
  id                    String   @id @default(uuid(7)) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  name                  String
  lat                   Float
  lng                   Float
  radiusM               Int      @map("radius_m")
  defaultScheduleId     String?  @map("default_schedule_id") @db.Uuid
  technoLinkBranchCode  String?  @map("techno_link_branch_code")
  createdBy             String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company         Company       @relation(fields: [companyId], references: [id])
  defaultSchedule WorkSchedule? @relation(fields: [defaultScheduleId], references: [id])

  @@index([companyId])
  @@map("branches")
}

model WorkSchedule {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  // "HH:mm" — a plain string, not @db.Time, so the Zod schema (packages/shared) that
  // validates the request body is the same shape as what's stored; no Date parsing.
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  lateGraceMin Int      @map("late_grace_min")
  // 0-6, matching Company.weekendDays' existing JS Date.getDay() convention.
  workDays     Int[]    @map("work_days")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  branches Branch[]

  @@index([companyId])
  @@map("work_schedules")
}

model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  paid      Boolean
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@map("holidays")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  email        String
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(invited)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdBy    String?    @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

/// System roles (is_system = true) are global — companyId is null. A company's own
/// custom roles carry companyId (docs/adr/0004-rls-deferred.md).
model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([companyId])
  @@map("roles")
}

/// Global catalog — identical for every company, seeded from packages/shared's
/// PERMISSIONS constant. Not tenant-scoped.
model Permission {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  scope        String @default("company")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Delivery (email) isn't wired up yet — no notifications module exists.
/// RequestPasswordResetUseCase logs the token; Phase 3 wires real email.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// Append-only. Written by every create/update/delete on employees, salary
/// components, attendance corrections, leave decisions, custody, and payroll
/// (AGENTS.md §3 rule 6) — enforced module by module as those modules are built.
model AuditLogEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  ip        String?
  at        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@map("audit_log")
}
