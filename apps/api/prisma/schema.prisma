// Stage 3 scope only (docs/roadmap.md Phase 0): companies, branches, users, roles,
// permissions, refresh_tokens, audit_log + the join tables roles/permissions need to
// be usable (role_permissions, user_roles). Employees, attendance, leave, custody,
// payroll tables land with their own modules in later phases.
//
// Tenancy (docs/adr/0004-rls-deferred.md): every business table carries company_id,
// NOT NULL, indexed. Two exceptions are intentionally global, not tenant-scoped:
// `permissions` (fixed resource:action catalog, mirrors packages/shared PERMISSIONS)
// and system rows of `roles` (is_system = true; a company's own custom roles do carry
// company_id). All reads/writes go through `withTenant()` (apps/api/src/shared/database),
// never a raw injected PrismaClient — see the ADR for why.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev/CI (glibc). linux-musl-openssl-3.0.x for the prod
  // image (node:24-alpine, Alpine 3.24, OpenSSL 3.x) — without it, the query
  // engine fails at runtime with "Error loading shared library libssl.so.1.1"
  // since modern Alpine dropped the OpenSSL 1.1 compat libs Prisma defaults to.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  disabled

  @@map("user_status")
}

model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  crNumber  String?  @map("cr_number")
  vatNumber String?  @map("vat_number")
  timezone  String   @default("Asia/Riyadh")
  weekendDays Int[]  @map("weekend_days") @default([5, 6])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  workSchedules       WorkSchedule[]
  holidays            Holiday[]
  departments         Department[]
  employees           Employee[]
  salaryComponents    SalaryComponent[]
  employeeDocuments   EmployeeDocument[]
  users               User[]
  roles               Role[]
  roleAssignments     RoleAssignment[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogEntries     AuditLogEntry[]
  documentExpiryNotices DocumentExpiryNotice[]
  notifications       Notification[]
  invitations         Invitation[]
  companySettings     CompanySetting[]
  attendanceDays      AttendanceDay[]
  attendancePunches   AttendancePunch[]
  attendanceCorrections AttendanceCorrection[]
  idempotencyKeys     IdempotencyKey[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  custodyRequests     CustodyRequest[]
  employeeAssignments EmployeeAssignment[]
  employeeContacts    EmployeeContact[]
  contracts           Contract[]
  insurancePolicies   InsurancePolicy[]
  employeeInsurance   EmployeeInsurance[]
  alertNotices        AlertNotice[]
  warnings            Warning[]
  shortLeaveRequests  ShortLeaveRequest[]
  payrollAdjustments  PayrollAdjustment[]

  @@map("companies")
}

model Branch {
  id                    String   @id @default(uuid(7)) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  name                  String
  lat                   Float
  lng                   Float
  radiusM               Int      @map("radius_m")
  defaultScheduleId     String?  @map("default_schedule_id") @db.Uuid
  technoLinkBranchCode  String?  @map("techno_link_branch_code")
  createdBy             String?  @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company         Company       @relation(fields: [companyId], references: [id])
  defaultSchedule WorkSchedule? @relation(fields: [defaultScheduleId], references: [id])
  employees       Employee[]
  assignmentBranches AssignmentBranch[]

  @@index([companyId])
  @@map("branches")
}

model WorkSchedule {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  // "HH:mm" — a plain string, not @db.Time, so the Zod schema (packages/shared) that
  // validates the request body is the same shape as what's stored; no Date parsing.
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  lateGraceMin Int      @map("late_grace_min")
  // 0-6, matching Company.weekendDays' existing JS Date.getDay() convention.
  workDays     Int[]    @map("work_days")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  branches  Branch[]
  employees Employee[]

  @@index([companyId])
  @@map("work_schedules")
}

model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  date      DateTime @db.Date
  name      String
  paid      Boolean
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@map("holidays")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  email        String
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(invited)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdBy    String?    @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  roleAssignments     RoleAssignment[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  employee            Employee?
  notifications       Notification[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

/// System roles (is_system = true) are global — companyId is null. A company's own
/// custom roles carry companyId (docs/adr/0004-rls-deferred.md).
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  /// Stable key of a system role (super_admin, employee, …); null for a company's own roles.
  key         String?  @unique
  name        String
  nameAr      String?  @map("name_ar")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  /// Seeded but not meant to be held until the company decides to (ADR-0011 §6.7).
  isTemplate  Boolean  @default(false) @map("is_template")
  /// Retired roles stay for history (audit, old assignments) but can't be assigned.
  archivedAt  DateTime? @map("archived_at")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  assignments     RoleAssignment[]

  @@index([companyId])
  @@map("roles")
}

/// Global catalog — identical for every company, seeded from packages/shared's
/// PERMISSIONS constant. Not tenant-scoped.
model Permission {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  /// Reach: own | team | branch | company (ADR-0011 §1).
  scope        String @default("company")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user holds a role (ADR-0011 §1). Several per user; access is the union. For branch-reach grants,
/// `branch_mode` home = the branch on the user's employee record (follows transfers), selected = the
/// branches in assignment_branches. valid_from/valid_to (company dates, inclusive) express temporary cover.
model RoleAssignment {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  branchMode String    @default("home") @map("branch_mode")
  validFrom  DateTime? @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  note       String?
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company  Company            @relation(fields: [companyId], references: [id])
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role               @relation(fields: [roleId], references: [id])
  branches AssignmentBranch[]

  @@index([companyId, userId])
  @@index([roleId])
  @@map("role_assignments")
}

model AssignmentBranch {
  assignmentId String @map("assignment_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  assignment RoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  branch     Branch         @relation(fields: [branchId], references: [id])

  @@id([assignmentId, branchId])
  @@index([branchId])
  @@map("assignment_branches")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Delivery (email) isn't wired up yet — no notifications module exists.
/// RequestPasswordResetUseCase logs the token; Phase 3 wires real email.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// docs/adr/0007-invitations.md. Owned by the auth module — auth never touches
/// the employees table; employees module validates the employee-side
/// precondition and calls into auth to create this row. Multiple rows per
/// employee are allowed (supports resend with no extra mechanism); accept-time
/// re-checks employees.user_id is still null so a stale second token can't
/// create a duplicate account.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  email       String
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("invitations")
}

/// Append-only. Written by every create/update/delete on employees, salary
/// components, attendance corrections, leave decisions, custody, and payroll
/// (AGENTS.md §3 rule 6) — enforced module by module as those modules are built.
model AuditLogEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  ip        String?
  at        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@index([companyId, at(sort: Desc), id(sort: Desc)])
  @@map("audit_log")
}

enum EmployeeStatus {
  active
  inactive

  @@map("employee_status")
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DepartmentParent", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentParent")
  employees Employee[]

  @@index([companyId])
  @@map("departments")
}

/// Two tenant-scoped FKs (national ID and employee number) are unique per
/// company, not globally — see the ADR-0004-style tenant-safety note this
/// module's application layer must also enforce for department/branch/
/// schedule/manager references (Postgres FKs alone don't stop cross-company
/// references since those tables are globally, not per-company, unique-keyed).
model Employee {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  userId       String?        @unique @map("user_id") @db.Uuid
  employeeNo   String         @map("employee_no")
  fullNameAr   String         @map("full_name_ar")
  fullNameEn   String         @map("full_name_en")
  // National ID (Saudi) or Iqama number (non-Saudi) — see isSaudi.
  nationalId   String         @map("national_id")
  nationality  String
  isSaudi      Boolean        @map("is_saudi")
  jobTitle     String?        @map("job_title")
  departmentId String?        @map("department_id") @db.Uuid
  branchId     String?        @map("branch_id") @db.Uuid
  scheduleId   String?        @map("schedule_id") @db.Uuid
  managerId    String?        @map("manager_id") @db.Uuid
  hireDate     DateTime       @map("hire_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  status       EmployeeStatus @default(active)
  // Employee self-service (docs/domain/business-rules.md "Employee onboarding").
  // Contact fields apply immediately; iban is the last APPROVED value (what
  // payroll would use), pendingIban a submission awaiting HR review.
  phone                 String?       @map("phone")
  personalEmail         String?       @map("personal_email")
  address               String?       @map("address")
  /// Deprecated (moved to employee_contacts, backfilled); no longer written.
  emergencyContactName  String?       @map("emergency_contact_name")
  /// Deprecated (moved to employee_contacts, backfilled); no longer written.
  emergencyContactPhone String?       @map("emergency_contact_phone")
  additionalPhone       String?       @map("additional_phone")
  /// male | female
  gender                String?
  birthDate             DateTime?     @map("birth_date") @db.Date
  /// single | married | divorced | widowed
  maritalStatus         String?       @map("marital_status")
  iban                  String?       @map("iban")
  pendingIban           String?       @map("pending_iban")
  ibanReviewStatus      ReviewStatus? @map("iban_review_status")
  ibanReviewReason      String?       @map("iban_review_reason")
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id])
  user             User?              @relation(fields: [userId], references: [id])
  department       Department?        @relation(fields: [departmentId], references: [id])
  branch           Branch?            @relation(fields: [branchId], references: [id])
  schedule         WorkSchedule?      @relation(fields: [scheduleId], references: [id])
  manager          Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  reports          Employee[]         @relation("EmployeeManager")
  salaryComponents SalaryComponent[]
  documents        EmployeeDocument[]
  invitations      Invitation[]
  attendanceDays   AttendanceDay[]
  attendancePunches AttendancePunch[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  custodyRequests  CustodyRequest[]
  assignments      EmployeeAssignment[] @relation("AssignmentEmployee")
  contacts         EmployeeContact[]
  contracts        Contract[]
  insurance        EmployeeInsurance[]
  warnings         Warning[]
  shortLeaveRequests ShortLeaveRequest[]
  payrollAdjustments PayrollAdjustment[]

  @@unique([companyId, employeeNo])
  @@unique([companyId, nationalId])
  @@index([companyId])
  @@map("employees")
}

/// Career history (ADR-0012): effective-dated branch, department, job title, manager and schedule.
/// Applied rows (applied_at set) form a gap-free timeline; the current one has valid_to null and its values
/// are mirrored on `employees` in the same transaction. A row with applied_at null is a scheduled
/// (future-dated) change, applied by the nightly job on valid_from. Past rows are never rewritten.
model EmployeeAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  /// hire | transfer | change (an edit of the employee record)
  kind         String
  branchId     String?   @map("branch_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  jobTitle     String?   @map("job_title")
  managerId    String?   @map("manager_id") @db.Uuid
  scheduleId   String?   @map("schedule_id") @db.Uuid
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  appliedAt    DateTime? @map("applied_at")
  reason       String?
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation("AssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, validFrom])
  @@index([companyId, appliedAt, validFrom])
  @@map("employee_assignments")
}

/// Relatives and trusted people to reach (personal data tier, ADR-0011 §3).
model EmployeeContact {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  name         String
  /// father | mother | spouse | sibling | son | daughter | relative | friend | other
  relationship String
  phone        String
  isEmergency  Boolean  @default(false) @map("is_emergency")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("employee_contacts")
}

/// Employment contracts (business-rules.md "Contracts"). One active at a time; a renewal is a new row
/// pointing at the one it renews (which becomes "renewed").
model Contract {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  /// fixed_term | open_ended
  type             String
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date
  /// active | renewed | ended
  status           String    @default("active")
  renewedFromId    String?   @map("renewed_from_id") @db.Uuid
  notes            String?
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status, endDate])
  @@map("contracts")
}

/// A company medical insurance policy (provider + policy number + period).
model InsurancePolicy {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  provider     String
  policyNumber String   @map("policy_number")
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  notes        String?
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company             @relation(fields: [companyId], references: [id])
  members EmployeeInsurance[]

  @@index([companyId])
  @@map("insurance_policies")
}

/// An employee's enrolment in a policy (employee only for now; dependants later — owner default 2026-09-30).
model EmployeeInsurance {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  policyId     String    @map("policy_id") @db.Uuid
  memberNumber String?   @map("member_number")
  /// Coverage class as the insurer names it (e.g. VIP, A, B, C).
  class        String
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company  Company         @relation(fields: [companyId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   InsurancePolicy @relation(fields: [policyId], references: [id])

  @@index([companyId, employeeId])
  @@index([policyId])
  @@map("employee_insurance")
}

/// One row per (kind, record, threshold): the expiry-alert job never repeats a reminder.
model AlertNotice {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  /// contract_end | probation_end | insurance_end
  kind          String
  entityId      String   @map("entity_id") @db.Uuid
  thresholdDays Int      @map("threshold_days")
  notifiedAt    DateTime @default(now()) @map("notified_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([kind, entityId, thresholdDays])
  @@index([companyId])
  @@map("alert_notices")
}

enum ReviewStatus {
  pending_review
  approved
  rejected

  @@map("review_status")
}

enum SalaryComponentType {
  basic
  housing
  transport
  other

  @@map("salary_component_type")
}

model SalaryComponent {
  id            String              @id @default(uuid(7)) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  employeeId    String              @map("employee_id") @db.Uuid
  type          SalaryComponentType
  // Integer halalas (AGENTS.md §3 rule 3) — never a float.
  amountHalalas BigInt              @map("amount_halalas")
  effectiveFrom DateTime            @map("effective_from") @db.Date
  effectiveTo   DateTime?           @map("effective_to") @db.Date
  createdBy     String?             @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@map("salary_components")
}

enum DocumentType {
  iqama
  passport
  national_id
  contract
  other

  @@map("document_type")
}

/// fileKey points into FileStorage (docs/adr/0005-file-storage-local-disk.md) —
/// this table never stores file bytes, only the key + metadata.
model EmployeeDocument {
  id         String       @id @default(uuid(7)) @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  employeeId String       @map("employee_id") @db.Uuid
  type       DocumentType
  number     String
  issueDate  DateTime?    @map("issue_date") @db.Date
  expiryDate DateTime?    @map("expiry_date") @db.Date
  fileKey    String       @map("file_key")
  // The uploaded file's own MIME type — needed to serve the download with
  // the right Content-Type.
  contentType String      @map("content_type")
  // ADR-0005: "the database stores only the file key + metadata (name,
  // type, size, checksum), never the file bytes" — originalFilename lets a
  // download restore the user's own file name/extension; sizeBytes and
  // checksumSha256 let a restore-from-backup be verified for integrity.
  originalFilename String  @map("original_filename")
  sizeBytes        Int     @map("size_bytes")
  checksumSha256   String  @map("checksum_sha256")
  // HR's own uploads are created "approved"; an employee's self-service
  // upload is "pending_review" until HR decides (rejections carry a reason).
  reviewStatus     ReviewStatus @default(pending_review) @map("review_status")
  reviewReason     String?      @map("review_reason")
  createdBy  String?      @map("created_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  expiryNotices DocumentExpiryNotice[]

  @@index([companyId])
  @@index([employeeId])
  @@map("employee_documents")
}

/// docs/adr/0006-document-expiry-job.md. One row per (document, threshold) —
/// thresholdDays is a real day-count from DOCUMENT_EXPIRY_REMINDER_DAYS, or the
/// reserved sentinel -1 meaning "already-expired notice sent" (distinct from any
/// real threshold). The unique constraint is the job's idempotency guarantee:
/// never re-notify the same document at the same threshold twice, even across
/// restarts or a run that catches up several missed thresholds at once.
model DocumentExpiryNotice {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  thresholdDays Int      @map("threshold_days")
  notifiedAt    DateTime @default(now()) @map("notified_at")

  company  Company          @relation(fields: [companyId], references: [id])
  document EmployeeDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, thresholdDays])
  @@index([companyId])
  @@map("document_expiry_notices")
}

/// docs/adr/0006-document-expiry-job.md. `type` is a free-form string, not a Prisma
/// enum — every future module (leave, custody, attendance) adds its own event types
/// here, and a shared enum would force each of them to edit this one central enum,
/// fighting the module-boundary rule. `titleKey`/`bodyParams` (not pre-rendered
/// title/body text) so the frontend renders in the viewer's own locale later
/// (AGENTS.md §4: never hardcode ar/en strings).
model Notification {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String
  titleKey        String    @map("title_key")
  bodyParams      Json      @map("body_params")
  entity          String
  entityId        String    @map("entity_id") @db.Uuid
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  company       Company @relation(fields: [companyId], references: [id])
  recipientUser User    @relation(fields: [recipientUserId], references: [id])

  @@index([companyId, recipientUserId])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// Company policies that are TBD or change over time (docs/domain/business-rules.md): GPS accuracy,
/// later GOSI rates and deduction policies. The value in force on a date is the row with the latest
/// effective_from <= that date; code falls back to a documented default when there is none.
model CompanySetting {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  key           String
  value         Json
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key, effectiveFrom])
  @@index([companyId])
  @@map("company_settings")
}

enum AttendanceStatus {
  present
  late
  absent
  leave
  holiday
  weekend
}

enum PunchKind {
  in
  out
}

/// One row per employee per work day (a calendar date in the company time zone). Created by the
/// first punch or by the nightly close job; `status` null = the day is still open (no punch judged yet).
model AttendanceDay {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  employeeId      String            @map("employee_id") @db.Uuid
  /// The employee's branch on this day (ADR-0012 snapshot) — branch scope and reports use it.
  branchId        String?           @map("branch_id") @db.Uuid
  workDate        DateTime          @map("work_date") @db.Date
  status          AttendanceStatus?
  firstInAt       DateTime?         @map("first_in_at")
  lastOutAt       DateTime?         @map("last_out_at")
  lateMin         Int               @default(0) @map("late_min")
  /// Late minutes excused by approved short permissions (الاستئذانات); lateMin is already net of them.
  excusedMin      Int               @default(0) @map("excused_min")
  workedMin       Int               @default(0) @map("worked_min")
  /// Checked in but never checked out; set by the nightly job for the manager to fix.
  missingCheckout Boolean           @default(false) @map("missing_checkout")
  /// A correction was applied; the nightly job never overwrites a corrected day.
  corrected       Boolean           @default(false)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id])
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  punches     AttendancePunch[]
  corrections AttendanceCorrection[]

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, branchId, workDate])
  @@map("attendance_days")
}

/// Every punch attempt, accepted or not. Only accepted punches count; rejected ones are kept for the
/// record (who tried from where) and never link to a day.
model AttendancePunch {
  id              String    @id @default(uuid(7)) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  attendanceDayId String?   @map("attendance_day_id") @db.Uuid
  kind            PunchKind
  at              DateTime
  lat             Float
  lng             Float
  accuracyM       Float     @map("accuracy_m")
  distanceM       Float?    @map("distance_m")
  accepted        Boolean
  rejectReason    String?   @map("reject_reason")
  deviceInfo      String?   @map("device_info")
  createdAt       DateTime  @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDay AttendanceDay? @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, at])
  @@index([attendanceDayId])
  @@map("attendance_punches")
}

model AttendanceCorrection {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  attendanceDayId String   @map("attendance_day_id") @db.Uuid
  oldValues       Json     @map("old_values")
  newValues       Json     @map("new_values")
  reason          String
  correctedBy     String   @map("corrected_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@index([attendanceDayId])
  @@map("attendance_corrections")
}

/// `Idempotency-Key` replay store (docs/architecture/overview.md): check-in now, payroll runs later.
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  key         String
  scope       String
  requestHash String   @map("request_hash")
  response    Json
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId, scope, key])
  @@map("idempotency_keys")
}

/// Seeded per company (annual, sick, emergency, unpaid); configurable. `defaultDays` null = no yearly limit.
model LeaveType {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  code           String
  nameAr         String   @map("name_ar")
  nameEn         String   @map("name_en")
  paid           Boolean
  deductsBalance Boolean  @map("deducts_balance")
  defaultDays    Int?     @map("default_days")
  /// Pay by cumulative days used in the year, e.g. sick leave [{"days":30,"percent":100},{"days":60,"percent":75},{"days":30,"percent":0}].
  /// Days past the last tier are unpaid. null = `paid` decides for every day.
  payTiers       Json?    @map("pay_tiers")
  /// A supporting document (e.g. medical certificate) must be attached before the request can be approved.
  requiresAttachment Boolean @default(false) @map("requires_attachment")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyId], references: [id])
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@map("leave_types")
}

/// One row per employee, balance-deducting leave type and year; created on first use with the
/// type's default entitlement (granted in full on January 1st, no carry-over — ADR-0010).
model LeaveBalance {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  leaveTypeId  String   @map("leave_type_id") @db.Uuid
  year         Int
  entitledDays Int      @map("entitled_days")
  usedDays     Int      @default(0) @map("used_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model LeaveRequest {
  id           String             @id @default(uuid(7)) @db.Uuid
  companyId    String             @map("company_id") @db.Uuid
  employeeId   String             @map("employee_id") @db.Uuid
  /// Branch the request was filed in (ADR-0012): its approvers keep it even if the employee transfers.
  branchId     String?            @map("branch_id") @db.Uuid
  leaveTypeId  String             @map("leave_type_id") @db.Uuid
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  /// Working days in the range (weekends and holidays excluded), fixed when requested.
  days         Int
  reason       String?
  status       LeaveRequestStatus @default(pending)
  decidedBy    String?            @map("decided_by") @db.Uuid
  decidedAt    DateTime?          @map("decided_at")
  decisionNote String?            @map("decision_note")
  /// Supporting document (medical certificate…), stored via FILE_STORAGE; type sniffed at upload.
  attachmentKey  String?          @map("attachment_key")
  attachmentName String?          @map("attachment_name")
  attachmentType String?          @map("attachment_type")
  createdBy    String?            @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId, employeeId, startDate])
  @@index([companyId, status])
  @@index([companyId, branchId, startDate])
  @@map("leave_requests")
}

enum CustodyStatus {
  requested
  approved
  rejected
  cancelled
  paid
  settled
}

/// عهدة: status only, no ledger (business-rules.md "Custody"). The money itself is paid and recorded
/// in Techno Link; `techno_link_ref` is that record's reference.
model CustodyRequest {
  id                   String        @id @default(uuid(7)) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  employeeId           String        @map("employee_id") @db.Uuid
  /// Branch the request was filed in (ADR-0012).
  branchId             String?       @map("branch_id") @db.Uuid
  amountHalalas        BigInt        @map("amount_halalas")
  purpose              String
  status               CustodyStatus @default(requested)
  decidedBy            String?       @map("decided_by") @db.Uuid
  decidedAt            DateTime?     @map("decided_at")
  decisionNote         String?       @map("decision_note")
  paidBy               String?       @map("paid_by") @db.Uuid
  paidAt               DateTime?     @map("paid_at")
  technoLinkRef        String?       @map("techno_link_ref")
  settledBy            String?       @map("settled_by") @db.Uuid
  settledAt            DateTime?     @map("settled_at")
  settledAmountHalalas BigInt?       @map("settled_amount_halalas")
  settlementNote       String?       @map("settlement_note")
  createdBy            String?       @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@index([companyId, branchId, createdAt])
  @@map("custody_requests")
}

/// إنذارات (business-rules.md "Warnings"): proposed → issued (or rejected) → acknowledged by the employee;
/// an issued warning can be rescinded with a reason. Never creates a deduction by itself.
model Warning {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  /// Branch snapshot (ADR-0012).
  branchId         String?   @map("branch_id") @db.Uuid
  /// verbal | written | final (the ladder; company policy TBD, see business-rules.md)
  type             String
  reason           String
  incidentDate     DateTime  @map("incident_date") @db.Date
  /// proposed | issued | rejected | rescinded
  status           String    @default("proposed")
  proposedBy       String    @map("proposed_by") @db.Uuid
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at")
  decisionNote     String?   @map("decision_note")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  rescindedBy      String?   @map("rescinded_by") @db.Uuid
  rescindedAt      DateTime? @map("rescinded_at")
  rescindedReason  String?   @map("rescinded_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([companyId, branchId, incidentDate])
  @@map("warnings")
}

/// الاستئذانات: part of a day away with approval. Approved late arrivals excuse lateness in attendance.
model ShortLeaveRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  date         DateTime  @db.Date
  /// late_arrival | early_leave | mid_day
  kind         String
  /// "HH:mm" company time, like work schedules.
  fromTime     String    @map("from_time")
  toTime       String    @map("to_time")
  minutes      Int
  reason       String
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, date])
  @@index([companyId, status])
  @@index([companyId, branchId, date])
  @@map("shortleave_requests")
}

/// A dated pay change for one employee and month (business-rules.md "Adjustments and deductions"):
/// proposed → approved by a different person → picked up by payroll (Phase 7). Approved rows are immutable;
/// a mistake is corrected with an opposite adjustment.
model PayrollAdjustment {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  /// YYYY-MM
  period        String
  /// deduction | bonus | allowance
  kind          String
  amountHalalas BigInt    @map("amount_halalas")
  reason        String
  /// manual | warning | absence | lateness | custody | shortleave
  source        String    @default("manual")
  sourceId      String?   @map("source_id") @db.Uuid
  /// proposed | approved | rejected
  status        String    @default("proposed")
  proposedBy    String    @map("proposed_by") @db.Uuid
  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, period, status])
  @@index([companyId, employeeId, period])
  @@index([companyId, branchId, period])
  @@map("payroll_adjustments")
}
