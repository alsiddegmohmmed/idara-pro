{
  "name": "@idara-pro/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"nest start --watch\" \"nest start --watch --entryFile worker\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "build": "nest build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "checkup": "tsx scripts/doctor.ts",
    "start": "concurrently -n api,worker -c blue,magenta \"node dist/main.js\" \"node dist/worker.js\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@idara-pro/shared": "workspace:*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^6.10.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.26",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.5",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.3"
  }
}
