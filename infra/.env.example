# Copy to infra/.env ON THE SERVER and fill with real secrets. Never commit .env.
POSTGRES_USER=idara
POSTGRES_PASSWORD=
POSTGRES_DB=idara_prod
# Must differ from POSTGRES_PASSWORD
IDARA_APP_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Redis password (required — prod compose refuses to start without it).
# Letters and digits ONLY: it is embedded in REDIS_URL.
REDIS_PASSWORD=

# The company subdomain pointing at the server, e.g. hr.company-domain.com
# (WEB_APP_URL and TRUST_PROXY are set by docker-compose.prod.yml from this)
DOMAIN=

# Email server (ask IT / your mail provider). Port 587 = STARTTLS.
# When SMTP_USER is set, TLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Idara Pro <noreply@your-company-domain>
